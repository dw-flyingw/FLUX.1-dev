# App Configuration
FRONTEND_PORT=8631
FLUX_INFERENCE_PORT=8630

# HPE Corporate Proxy (required for HPE corporate network)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# SSL Certificates (required for Zscaler SSL inspection)
SSL_CERT_FILE=/etc/ssl/certs/ca-bundle-combined.pem
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-bundle-combined.pem
CURL_CA_BUNDLE=/etc/ssl/certs/ca-bundle-combined.pem

# Hugging Face Configuration
HF_HOME=/data/hub/huggingface
HF_HUB_DISABLE_SSL_VERIFY=1
HF_TOKEN=

# NGC / NIM Configuration
NGC_API_KEY=
NGC_ORG_ID=

# Path to pre-downloaded models
HUGGINGFACE_MODEL_PATH=/data/hub/huggingface

# GPU Device Selection (0-3)
NVIDIA_GPU_DEVICE=1

# Prompt Extension LLM (OpenAI-compatible endpoint, leave empty to disable)
PROMPT_EXTEND_MODEL=
